generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  BANNED
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

model User {
  id           String       @id @default(cuid())
  fullName     String
  email        String       @unique
  phone        String?      @unique
  passwordHash String?
  authProvider AuthProvider @default(EMAIL)

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?

  birthDate  DateTime @db.Date
  birthMonth Int
  birthDay   Int
  ageBracket String?

  gender Gender

  autoJoinBirthdayCommunities Boolean @default(true)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  profile       Profile?
  interests     UserInterest[]

  @@index([birthMonth, birthDay])
  @@index([ageBracket])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@map("otp_codes")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  username    String  @unique
  bio         String? @db.VarChar(500)
  avatarUrl   String?
  blobTint    String?

  visibility       ProfileVisibility @default(PUBLIC)
  showBirthYear    Boolean           @default(false)
  showAge          Boolean           @default(true)
  showLocation     Boolean           @default(true)
  showOnlineStatus Boolean           @default(true)

  city      String?
  country   String?
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, country])
  @@map("profiles")
}

model Interest {
  id    String         @id @default(cuid())
  name  String         @unique
  slug  String         @unique
  users UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, interestId])
  @@index([interestId])
  @@map("user_interests")
}