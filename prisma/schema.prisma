generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  BANNED
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum CommunityType {
  BIRTHDAY    
  BIRTH_MONTH  
  AGE_BRACKET  
  ANNIVERSARY
}

enum JoinMethod {
  AUTO   
  MANUAL  
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO     
  VOICE_NOTE 
  SYSTEM     
}

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED
  DECLINED
  FAILED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  NEW_MESSAGE
  MISSED_CALL
  UPCOMING_BIRTHDAY
  BIRTHDAY_TODAY
  POST_REACTION
  POST_COMMENT
  COMMUNITY_JOINED
  ANNOUNCEMENT
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  POST
  MESSAGE
  COMMENT
}

model User {
  id           String       @id @default(cuid())
  fullName     String
  email        String       @unique
  phone        String?      @unique
  passwordHash String?
  authProvider AuthProvider @default(EMAIL)

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?

  birthDate  DateTime @db.Date
  birthMonth Int
  birthDay   Int
  ageBracket String?

  anniversaryMonth Int?
  anniversaryDay   Int?

  gender Gender

  autoJoinBirthdayCommunities Boolean @default(true)

  lastSeenAt DateTime?
  onboardingComplete            Boolean                  @default(false)   
  onboardingStep     Int     @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  profile       Profile?
  interests     UserInterest[]
  memberships CommunityMembership[]
  sentFriendships     Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")
  following           Follow[]     @relation("Follower")
  followers           Follow[]     @relation("Followee")
  blocksInitiated     Block[]      @relation("Blocker")
  blocksReceived      Block[]      @relation("Blocked")
  posts     Post[]
  comments  Comment[]
  reactions Reaction[]

  conversationsCreated Conversation[]            @relation("ConversationCreator")
  participations       ConversationParticipant[]
  messages             Message[]
  callsInitiated     Call[]            @relation("CallInitiator")
  callParticipations CallParticipant[]

  notifications       Notification[]         @relation("NotificationRecipient")
  notificationsCaused Notification[]         @relation("NotificationActor")
  notificationPrefs   NotificationPreference?
  pushSubscriptions   PushSubscription[]
  stories        Story[]
  storyViews     StoryView[]
  storyReactions StoryReaction[]

  reportsFiled   Report[] @relation("Reporter")
  reportsAgainst Report[] @relation("ReportedUser")

  @@index([birthMonth, birthDay])
  @@index([anniversaryMonth, anniversaryDay])
  @@index([ageBracket])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@map("otp_codes")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  username    String  @unique
  bio         String? @db.VarChar(500)
  avatarUrl   String?
  coverUrl    String?
  blobTint    String?

  visibility       ProfileVisibility @default(PUBLIC)
  showBirthYear    Boolean           @default(false)
  showAge          Boolean           @default(true)
  showAnniversary  Boolean           @default(true)
  showLocation     Boolean           @default(true)
  showOnlineStatus Boolean           @default(true)

  city      String?
  country   String?
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, country])
  @@map("profiles")
}

model Interest {
  id    String         @id @default(cuid())
  name  String         @unique
  slug  String         @unique
  users UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, interestId])
  @@index([interestId])
  @@map("user_interests")
}

model BirthdayCommunity {
  id   String        @id @default(cuid())
  type CommunityType

  month   Int?
  day     Int?
  bracket String?

  name        String
  description String?
  coverTint   String?
  memberCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships CommunityMembership[]

  @@unique([type, month, day, bracket])
  @@map("birthday_communities")
}

model CommunityMembership {
  id          String            @id @default(cuid())
  userId      String
  communityId String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   BirthdayCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)

  joinMethod JoinMethod
  joinedAt   DateTime   @default(now())

  @@unique([userId, communityId])
  @@index([communityId, joinMethod])
  @@map("community_memberships")
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status]) // "my pending requests" inbox
  @@map("friendships")
}

model Follow {
  followerId String
  followeeId String
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId]) // "who follows me"
  @@map("follows")
}

model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Post {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body           String? @db.VarChar(2000)
  isBirthdayPost Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  media     PostMedia[]
  comments  Comment[]
  reactions Reaction[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

model PostMedia {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  url    String
  type   String
  width  Int?
  height Int?
  order  Int    @default(0)

  @@index([postId])
  @@map("post_media")
}

model Comment {
  id       String @id @default(cuid())
  postId   String
  authorId String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body     String    @db.VarChar(1000)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  reactions Reaction[]

  @@index([postId, createdAt])
  @@map("comments")
}

model Reaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji     String
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId, emoji])
  @@unique([userId, commentId, emoji])
  @@index([postId])
  @@index([commentId])
  @@map("reactions")
}

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType
  creatorId String?
  creator   User?            @relation("ConversationCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  title     String?
  avatarUrl String?

  pairKey String? @unique

  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  calls        Call[]

  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  isAdmin    Boolean   @default(false)
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  lastReadAt DateTime?
  mutedUntil DateTime?

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  type MessageType @default(TEXT)
  body String?     @db.VarChar(4000)

  mediaUrl      String?
  mediaDuration Int?
  mediaSize     Int?

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")
  replyToStoryId String?

  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model Call {
  id             String       @id @default(cuid())
  conversationId String
  initiatorId    String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiator      User         @relation("CallInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)

  type   CallType
  status CallStatus @default(RINGING)

  startedAt  DateTime  @default(now())
  answeredAt DateTime?
  endedAt    DateTime?

  participants CallParticipant[]

  @@index([conversationId, startedAt(sort: Desc)]) 
  @@map("calls")
}

model CallParticipant {
  id     String @id @default(cuid())
  callId String
  userId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([callId, userId])
  @@map("call_participants")
}

model Notification {
  id          String  @id @default(cuid())
  recipientId String
  actorId     String? // who caused it; null for system announcements
  recipient   User    @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type  NotificationType
  title String
  body  String?

  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailBirthdayDigest Boolean @default(true)
  emailFriendRequests Boolean @default(true)
  pushMessages        Boolean @default(true)
  pushCalls           Boolean @default(true)
  pushBirthdays       Boolean @default(true)
  pushSocial          Boolean @default(true)

  @@map("notification_preferences")
}

model PushSubscription {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model Report {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  targetId   String 

  
  reportedUserId String?
  reportedUser   User?   @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  reason  String
  details String? @db.VarChar(1000)
  status  ReportStatus @default(OPEN)

  resolvedById String?
  resolvedAt   DateTime?
  resolution   String? 

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@map("reports")
}

model Story {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaUrl  String
  mediaType String        // "IMAGE" | "VIDEO"
  caption   String?  @db.VarChar(200)

  createdAt DateTime @default(now())
  expiresAt DateTime

  views     StoryView[]
  reactions StoryReaction[]

  @@index([userId, expiresAt])
  @@map("stories")
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  viewerId String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@map("story_views")
}

model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@map("story_reactions")
}