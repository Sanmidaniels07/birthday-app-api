# ---- Runtime ----
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ---- Database (Supabase → Connect) ----
# Transaction pooler (port 6543) — the app's queries
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432) — migrations (Prisma CLI)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Auth (generate each with: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=<48-random-bytes-base64>
JWT_REFRESH_SECRET=<different-48-random-bytes-base64>

# ---- Email (Resend) — optional locally; emails log to console if unset ----
RESEND_API_KEY=<re_...>
EMAIL_FROM="Birthday App <onboarding@resend.dev>"

# ---- Cloudinary (dashboard → Cloud name / API key / API secret) ----
# Optional locally; upload endpoints return 400 if unset
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# ---- TURN (Metered.ca) — optional; without it calls are STUN-only ----
METERED_DOMAIN=<your-app>.metered.live
METERED_SECRET=<api-key-from-turn-server-page>

VAPID_PUBLIC_KEY=<public-key-from-generator>
VAPID_PRIVATE_KEY=<private-key-from-generator>
VAPID_SUBJECT=mailto:<address-you-own>